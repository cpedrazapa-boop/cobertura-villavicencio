rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos de la página de cobertura
    match /cobertura/{docId} {
      // Cualquiera con el enlace puede ver los datos
      allow read: if true;
      // Solo estos correos pueden publicar (los mismos de firebase-config.js)
      allow write: if request.auth != null
                   && request.auth.token.email in ['tu-correo@gmail.com'];
    }
  }
}
