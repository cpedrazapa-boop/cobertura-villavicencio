rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos de cada centro: cobertura (Villavicencio AV19), cobertura_AV24 (Yopal)
    match /{col}/{docId} {
      // Cualquiera con el enlace puede ver los datos
      allow read: if col in ['cobertura', 'cobertura_AV24'];
      // Solo estos correos pueden publicar (los mismos de firebase-config.js)
      allow write: if col in ['cobertura', 'cobertura_AV24']
                   && request.auth != null
                   && request.auth.token.email in ['cpedrazapa@gmail.com'];
    }
  }
}
